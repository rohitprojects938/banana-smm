<div class="container py-10">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-50 text-red-700 border border-red-200 rounded-xl p-4 mb-6">
            <%= error %>
        </div>
    <% } %>

    <% if (inspectedUser) { %>
        <h2 class="text-2xl font-bold mb-6">
            User: <%= inspectedUser.username %>
        </h2>

        <div class="bg-white rounded-xl shadow p-6 mb-8">
            <p><strong>Email:</strong> <%= inspectedUser.email || '-' %></p>
            <p><strong>Balance:</strong> &#8377;<%= Number(inspectedUser.balance || 0).toFixed(2) %></p>
            <p><strong>Joined:</strong> <%= inspectedUser.created_at %></p>
        </div>

        <h3 class="font-bold mb-4">Orders</h3>

        <table class="w-full text-sm border">
            <thead class="bg-gray-100">
                <tr>
                    <th class="p-2">Order ID</th>
                    <th class="p-2">Service</th>
                    <th class="p-2">Qty</th>
                    <th class="p-2">Status</th>
                    <th class="p-2">Date</th>
                </tr>
            </thead>
            <tbody>
                <% (orders || []).forEach(o => { %>
                    <tr class="border-b">
                        <td class="p-2">#<%= o.id %></td>
                        <td class="p-2"><%= o.service_name %></td>
                        <td class="p-2"><%= o.quantity %></td>
                        <td class="p-2 font-semibold"><%= o.status %></td>
                        <td class="p-2"><%= o.created_at %></td>
                    </tr>
                <% }) %>
                <% if (!orders || orders.length === 0) { %>
                    <tr>
                        <td colspan="5" class="p-4 text-center text-gray-500">No orders found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    <% } %>
</div>

