        </div>
        <h3 class="font-bold text-slate-800 text-sm">Order History</h3>
        <p class="text-xs text-slate-500 mt-1">Track status</p>
    </a>

   <a href="https://ig.me/m/2928999_._" target="_blank" rel="noopener noreferrer" class="glass-panel p-5 rounded-2xl hover-lift bg-gradient-purple group block">

        <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center mb-3 group-hover:bg-purple-500 group-hover:text-white transition-colors">
            <i class="fa-brands fa-instagram text-xl"></i>
