    </a>

    <a href="/funds" class="glass-panel p-5 rounded-2xl hover-lift bg-gradient-green group block">
        <div class="w-10 h-10 rounded-lg bg-green-100 text-green-600 flex items-center justify-center mb-3 group-hover:bg-green-500 group-hover:text-white transition-colors">
