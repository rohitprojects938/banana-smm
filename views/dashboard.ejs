<script src="/js/main.js"></script>

<div class="animate-fade-in-up">
<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div class="min-w-0 w-full md:w-auto px-6">
        <div class="flex items-center gap-3 mb-1 flex-wrap">
            <h1 class="text-2xl font-bold text-slate-900 break-words">
                 Welcome back, <%= user.username %>! 👋
            </h1>
            <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-xs font-medium border border-green-200 shrink-0">
                <i class="fa-solid fa-shield-check"></i> Verified Panel
            </span>
        </div>
        <p class="text-slate-500 text-sm break-words">
            Track your orders, add funds, and boost your growth instantly.
        </p>
    </div>

    <div class="flex items-center gap-3 w-full md:w-auto flex-wrap md:flex-nowrap">
