<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <!-- HEADER -->
    <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold text-gray-800">Admin Control</h2>
        <span class="bg-red-100 text-red-600 px-3 py-1 rounded text-sm font-bold">Super Admin</span>
    </div>

    <!-- ===================== -->
    <!-- TOP ANALYTICS CARDS -->
    <!-- ===================== -->

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-6">

        <div class="bg-white rounded-2xl shadow p-6">
            <p class="text-sm text-gray-500">Today Orders</p>
            <p class="text-3xl font-bold"><%= todayOrders || 0 %></p>
        </div>

        <div class="bg-white rounded-2xl shadow p-6">
            <p class="text-sm text-gray-500">Today Revenue</p>
            <p class="text-3xl font-bold text-green-600">
                &#8377;<%= Number(todayRevenue||0).toFixed(2) %>
            </p>
        </div>

        <div class="bg-white rounded-2xl shadow p-6">
            <p class="text-sm text-gray-500">Total Users</p>
            <p class="text-3xl font-bold text-blue-600">
                <%= users?.length || 0 %>
            </p>
        </div>

    </div>

    <!-- ===================== -->
    <!-- PROFIT + PROVIDER -->
    <!-- ===================== -->

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">

        <div class="bg-white rounded-2xl shadow p-6">
            <p class="text-sm text-gray-500">Total Revenue</p>
            <p class="text-xl font-bold text-blue-600">
                &#8377;<%= Number(totalRevenue||0).toFixed(2) %>
            </p>
        </div>

        <div class="bg-white rounded-2xl shadow p-6">
            <p class="text-sm text-gray-500">Provider Cost</p>
            <p class="text-xl font-bold text-orange-600">
                &#8377;<%= Number(providerCost||0).toFixed(2) %>
            </p>
        </div>

        <div class="bg-white rounded-2xl shadow p-6">
            <p class="text-sm text-gray-500">Net Profit</p>
            <p class="text-xl font-bold text-green-700">
                &#8377;<%= Number(totalProfit||0).toFixed(2) %>
            </p>
        </div>

        <div class="bg-black text-white rounded-2xl p-6">
            <p class="text-sm opacity-70">Provider Balance</p>
            <p class="text-xl font-bold">
                $<%= providerBalance || 'N/A' %>
            </p>
        </div>

    </div>

    <!-- ===================== -->
    <!-- CHARTS -->
    <!-- ===================== -->

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">

        <div class="bg-white p-6 rounded-2xl shadow">
            <h3 class="font-bold mb-4">Orders Last 7 Days</h3>
            <canvas id="ordersChart"></canvas>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow">
            <h3 class="font-bold mb-4">Order Status</h3>
            <canvas id="statusChart"></canvas>
        </div>

    </div>

    <!-- ===================== -->
    <!-- SERVICE REVENUE -->
    <!-- ===================== -->

    <div class="bg-white p-6 rounded-2xl shadow mb-12">
        <h3 class="font-bold mb-4">Revenue by Service</h3>
        <canvas id="serviceRevenueChart"></canvas>
    </div>

    <!-- ===================== -->
    <!-- TOP USERS -->
    <!-- ===================== -->

    <div class="bg-white rounded-2xl shadow p-6 mb-12">
        <h3 class="font-bold mb-4">Top Spending Users</h3>

        <table class="w-full text-sm">
            <thead>
                <tr class="text-gray-500">
                    <th class="px-2 py-1 sm:p-2 text-left">User</th>
                    <th class="px-2 py-1 sm:p-2 text-left">Spend</th>
                </tr>
            </thead>
            <tbody>
                <% (topUsers || []).forEach(u => { %>
                    <tr class="border-b">
                        <td class="px-2 py-1 sm:p-2"><%= u.username %></td>
                        <td class="px-2 py-1 sm:p-2 font-bold">
                            &#8377;<%= Number(u.spend).toFixed(2) %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- ===================== -->
    <!-- FUND REQUESTS -->
    <!-- ===================== -->

    <div class="bg-white rounded-2xl shadow mb-12">
        <button 
            onclick="toggleSection('fundSection')" 
            class="w-full flex justify-between items-center px-4 py-4 sm:p-6 text-left font-bold text-lg"
        >
            <span>Fund Requests</span>
            <span id="fundSectionIcon">▲</span>
        </button>

        <div id="fundSection" class="px-6 pb-6">
            <div class="overflow-x-auto sm:overflow-visible">
            <table class="w-full text-xs sm:text-sm border">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-left">User</th>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-left">Requested</th>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-left">Txn ID</th>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-left">Status</th>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-left">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% (fundRequests || []).forEach(r => { %>
                        <tr class="border-b">
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm"><%= r.username %></td>
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm">&#8377;<%= r.requested_amount %></td>
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm"><%= r.txn_id %></td>
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm">
                                <span class="
                                    <% if(r.status==='approved'){ %> text-green-600
                                    <% } else if(r.status==='rejected'){ %> text-red-600
                                    <% } else { %> text-yellow-600 <% } %>
                                    font-semibold
                                ">
                                    <%= r.status %>
                                </span>
                            </td>
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm">
                                <% if(r.status === 'pending') { %>

                                    <!-- MOBILE VERSION -->
                                    <div class="flex flex-col space-y-2 sm:hidden">

                                        <form method="POST" action="/admin/funds/approve" class="flex flex-col space-y-2">
                                            <input type="hidden" name="id" value="<%= r.id %>">

                                            <input 
                                                type="number"
                                                name="approved_amount"
                                                value="<%= r.requested_amount %>"
                                                min="10"
                                                required
                                                class="border px-2 py-1 w-full rounded text-sm"
                                            >

                                            <button 
                                                type="submit"
                                                class="bg-green-600 text-white py-2 rounded w-full text-sm"
                                            >
                                                Approve
                                            </button>
                                        </form>

                                        <form method="POST" action="/admin/funds/reject">
                                            <input type="hidden" name="id" value="<%= r.id %>">
                                            <button 
                                                type="submit"
                                                class="bg-red-600 text-white py-2 rounded w-full text-sm"
                                                onclick="return confirm('Are you sure you want to reject this request?')"
                                            >
                                                Reject
                                            </button>
                                        </form>

                                    </div>

                                    <!-- DESKTOP VERSION -->
                                    <div class="hidden sm:flex items-center gap-2">

                                        <form method="POST" action="/admin/funds/approve" class="flex items-center gap-2">
                                            <input type="hidden" name="id" value="<%= r.id %>">

                                            <input 
                                                type="number"
                                                name="approved_amount"
                                                value="<%= r.requested_amount %>"
                                                min="10"
                                                required
                                                class="border px-2 py-1 w-24 rounded text-sm"
                                            >

                                            <button 
                                                type="submit"
                                                class="bg-green-600 text-white px-3 py-1 rounded text-sm"
                                            >
                                                Approve
                                            </button>
                                        </form>

                                        <form method="POST" action="/admin/funds/reject">
                                            <input type="hidden" name="id" value="<%= r.id %>">
                                            <button 
                                                type="submit"
                                                class="bg-red-600 text-white px-3 py-1 rounded text-sm"
                                                onclick="return confirm('Are you sure you want to reject this request?')"
                                            >
                                                Reject
                                            </button>
                                        </form>

                                    </div>

                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <!-- ===================== -->
    <!-- PENDING MANUAL ORDERS -->
    <!-- ===================== -->

    <div class="bg-white rounded-2xl shadow mb-12">
        <button 
            onclick="toggleSection('manualSection')" 
            class="w-full flex justify-between items-center px-4 py-4 sm:p-6 text-left font-bold text-lg"
        >
            <span>Pending Manual Orders</span>
            <span id="manualSectionIcon">▲</span>
        </button>

        <div id="manualSection" class="px-6 pb-6">
            <div class="overflow-x-auto sm:overflow-visible">
            <table class="w-full text-sm border">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm">Order</th>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm">User</th>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm">Service</th>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm">Qty</th>
                        <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm">Update</th>
                    </tr>
                </thead>

                <tbody>
                    <% (orders||[]).forEach(o => { if(((o.status || '').toLowerCase() === 'pending') && o.provider_order_id == null){ %>
                        <tr class="border-b">
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-gray-400">#<%= o.id %></td>
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm"><%= o.user_id %></td>
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm"><%= o.service_name || o.service_id %></td>
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm"><%= o.quantity %></td>
                            <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm">
                                <form method="POST" action="/admin/update-order" class="flex gap-2">
                                    <input type="hidden" name="order_id" value="<%= o.id %>">
                                    <input name="provider_order_id" required class="border px-2 py-1">
                                    <select name="status" class="border px-2 py-1">
                                        <option value="Processing">Processing</option>
                                        <option value="Completed">Completed</option>
                                    </select>
                                    <button class="bg-blue-600 text-white text-xs sm:text-sm px-2 sm:px-3 py-1 rounded">
                                        Update
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }}); %>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <!-- ===================== -->
    <!-- ALL USERS -->
    <!-- ===================== -->

    <div class="bg-white rounded-2xl shadow mb-12">
        <button 
            onclick="toggleSection('allUsersSection')" 
            class="w-full flex justify-between items-center px-4 py-4 sm:p-6 text-left font-bold text-lg"
        >
            <span>All Users</span>
            <span id="allUsersSectionIcon">▲</span>
        </button>

        <div id="allUsersSection" class="px-6 pb-6">
            <div class="max-h-96 overflow-y-auto overflow-x-auto">
                <table class="w-full text-xs sm:text-sm border">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-left">Username</th>
                            <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-left">Balance</th>
                            <th class="px-2 py-1 sm:p-2 text-xs sm:text-sm text-left">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (users || []).forEach(u => { %>
                            <tr class="border-b">
                                <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm"><%= u.username %></td>
                                <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm font-bold">
                                    &#8377;<%= Number(u.balance || 0).toFixed(2) %>
                                </td>
                                <td class="px-2 py-1 sm:p-2 text-xs sm:text-sm">
                                    <a href="/admin/user/<%= u.id %>" class="text-blue-600 font-semibold text-xs sm:text-sm px-2 sm:px-3 py-1 inline-block">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ===================== -->
    <!-- PROVIDERS -->
    <!-- ===================== -->

    <div class="bg-white rounded-2xl shadow mb-12">
        <button 
            onclick="toggleSection('providersSection')" 
            class="w-full flex justify-between items-center px-4 py-4 sm:p-6 text-left font-bold text-lg"
        >
            <span>Providers</span>
            <span id="providersSectionIcon">▲</span>
        </button>

        <div id="providersSection" class="px-6 pb-6">
            <div class="overflow-x-auto">
            <table class="w-full text-sm border">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-4 py-2 text-left">Name</th>
                        <th class="px-4 py-2 text-left">Balance</th>
                        <th class="px-4 py-2 text-left">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% (providers||[]).forEach(p => { %>
                        <tr class="border-b">
                            <td class="px-4 py-2"><%= p.name %></td>
                            <td class="px-4 py-2">$<%= p.balance %></td>
                            <td class="px-4 py-2">
                                <a href="/admin/sync-services" class="text-blue-600">Sync</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            </div>
        </div>
    </div>

</div>

<!-- ===================== -->
<!-- CHART SCRIPTS -->
<!-- ===================== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
function toggleSection(id) {
    const el = document.getElementById(id);
    const icon = document.getElementById(id + "Icon");

    if (el.classList.contains("hidden")) {
        el.classList.remove("hidden");
        icon.innerText = "▲";
    } else {
        el.classList.add("hidden");
        icon.innerText = "▼";
    }
}

const daily = <%- JSON.stringify(dailyOrders || []) %>;
const statusRows = <%- JSON.stringify(statusRows || []) %>;
const serviceRevenue = <%- JSON.stringify(serviceRevenue || []) %>;

new Chart(document.getElementById('ordersChart'), {
    type: 'bar',
    data: {
        labels: daily.map(x => x.d),
        datasets: [{
            data: daily.map(x => x.c),
            backgroundColor: '#6366f1'
        }]
    }
});

new Chart(document.getElementById('statusChart'), {
    type: 'doughnut',
    data: {
        labels: statusRows.map(x => x.status),
        datasets: [{
            data: statusRows.map(x => x.c),
            backgroundColor: ['#10b981', '#f59e0b', '#ef4444', '#3b82f6', '#a855f7']
        }]
    }
});

new Chart(document.getElementById('serviceRevenueChart'), {
    type: 'bar',
    data: {
        labels: serviceRevenue.map(x => x.name),
        datasets: [{
            data: serviceRevenue.map(x => x.revenue),
            backgroundColor: '#22c55e'
        }]
    }
});

// auto refresh
setInterval(()=>location.reload(),60000);
</script>



