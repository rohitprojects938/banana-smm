<div class="animate-fade-in-up px-4 md:px-8">

  <!-- PAGE HEADER -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-1">
      <h1 class="text-2xl font-bold text-slate-800">Affiliate Dashboard</h1>
      <span class="bg-blue-50 text-blue-600 text-[11px] font-bold px-2.5 py-0.5 rounded-full border border-blue-100 uppercase">
        10% Commission Active
      </span>
    </div>
    <p class="text-slate-500 text-sm">
      Earn commission on every completed order from your referrals.
    </p>
  </div>

  <!-- REFERRAL LINK -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 mb-8 shadow-sm">
    <label class="block text-sm font-semibold text-slate-700 mb-3">
      Your Referral Link
    </label>

    <div class="flex flex-col md:flex-row gap-3">
      <input
        type="text"
        readonly
        value="<%= affiliate.refLink %>"
        class="w-full bg-slate-50 border border-slate-200 text-slate-500 font-mono text-sm rounded-xl py-3 px-4"
      />

      <button
        onclick="copyAffiliateLink()"
        class="bg-slate-900 hover:bg-slate-800 text-white px-6 py-3 rounded-xl font-medium shadow-lg transition">
        Copy Link
      </button>
    </div>

    <p class="text-xs text-slate-400 mt-3">
      Share this link to earn commission from referred users.
    </p>
  </div>

  <!-- STATS -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 max-w-6xl mx-auto">
    <div class="glass-panel p-5 rounded-2xl">
      <p class="text-xs text-slate-500 uppercase">Referral Visits</p>
      <h3 class="text-2xl font-bold text-slate-800"><%= affiliate.visits %></h3>
    </div>

    <div class="glass-panel p-5 rounded-2xl">
      <p class="text-xs text-slate-500 uppercase">Total Referrals</p>
      <h3 class="text-2xl font-bold text-slate-800"><%= affiliate.registrations %></h3>
    </div>

    <div class="glass-panel p-5 rounded-2xl">
      <p class="text-xs text-slate-500 uppercase">Conversion</p>
      <h3 class="text-2xl font-bold text-slate-800"><%= affiliate.conversion %>%</h3>
    </div>

    <div class="glass-panel p-5 rounded-2xl">
      <p class="text-xs text-slate-500 uppercase">Total Earnings</p>
      <h3 class="text-2xl font-bold text-slate-800">
        &#8377;<%= Number(affiliate.totalEarnings).toFixed(2) %>
      </h3>
    </div>
  </div>

  <!-- EARNINGS SUMMARY -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white border-l-4 border-l-green-500 border border-slate-200 p-6 rounded-2xl">
      <p class="text-slate-500 text-sm">Available Earnings</p>
      <h2 class="text-3xl font-bold text-slate-800 mt-1">
        &#8377;<%= Number(affiliate.approvedEarnings).toFixed(2) %>
      </h2>
    </div>

    <div class="bg-white border-l-4 border-l-yellow-400 border border-slate-200 p-6 rounded-2xl">
      <p class="text-slate-500 text-sm">Pending Earnings</p>
      <h2 class="text-3xl font-bold text-slate-800 mt-1">
        &#8377;<%= Number(affiliate.pendingEarnings).toFixed(2) %>
      </h2>
      <p class="text-xs text-slate-400 mt-1">
        Earnings are approved after order completion.
      </p>
    </div>
  </div>

  <!-- INFO BOX -->
  <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
    <h4 class="font-bold text-slate-800 mb-2">Affiliate Rules</h4>
    <ul class="text-sm text-slate-600 list-disc pl-5 space-y-1">
      <li>Commission is credited only on completed orders.</li>
      <li>Self referrals are not allowed.</li>
      <li>Spam or abuse may result in rejection.</li>
    </ul>
  </div>

  <div
    id="copyToast"
    class="fixed top-6 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-4 py-2 rounded-xl text-sm shadow-lg opacity-0 pointer-events-none transition-all duration-300 z-50">
    ✅ Link copied to clipboard
  </div>

</div>

<script>
  function copyAffiliateLink() {
    const link = "<%= affiliate.refLink %>";

    navigator.clipboard.writeText(link).then(() => {
      const toast = document.getElementById("copyToast");
      toast.classList.remove("opacity-0");
      toast.classList.add("opacity-100");

      setTimeout(() => {
        toast.classList.remove("opacity-100");
        toast.classList.add("opacity-0");
      }, 2000);
    });
  }
</script>

