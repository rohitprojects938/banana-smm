    <style>
        :root {
            --primary: #2563eb; /* Blue */
            --secondary: #10b981; /* Green */
            --accent: #facc15; /* Banana Yellow */
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            overflow-x: hidden;
        }

        /* --- Premium Glassmorphism --- */
        .glass-nav {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.05);
        }

        /* --- Premium Banana Icon --- */
        .banana-icon-svg {
            filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.6));
            transition: all 0.3s ease;
        }
        
        .banana-glow-container:hover .banana-icon-svg {
            filter: drop-shadow(0 0 15px rgba(250, 204, 21, 0.9));
            transform: scale(1.1) rotate(-5deg);
        }

        /* --- 3D Background Elements --- */
        .blob-3d {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.6;
            z-index: -1;
            animation: float 10s ease-in-out infinite;
        }
        
        .blob-blue { background: radial-gradient(circle, #3b82f6 0%, transparent 70%); }
        .blob-green { background: radial-gradient(circle, #10b981 0%, transparent 70%); }
        .blob-yellow { background: radial-gradient(circle, #facc15 0%, transparent 70%); }

        @keyframes float {
            0% { transform: translateY(0px) translateX(0px); }
            33% { transform: translateY(-30px) translateX(20px); }
            66% { transform: translateY(10px) translateX(-10px); }
            100% { transform: translateY(0px) translateX(0px); }
        }

        /* --- Scroll Reveal --- */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- 3D Dashboard Tilt Effect --- */
        .hero-dashboard-container {
            perspective: 1500px;
            transform-style: preserve-3d;
        }
        
        .card-3d-interactive {
            transition: transform 0.1s ease-out, box-shadow 0.3s ease;
            transform-style: preserve-3d;
            background: rgba(15, 23, 42, 0.95); /* Darker background for contrast */
        }
        
        .card-3d-interactive::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, rgba(255,255,255,0) 30%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0) 70%);
            background-size: 200% 200%;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            border-radius: 1rem;
            z-index: 10;
        }

        .card-3d-interactive:hover::before {
            opacity: 1;
        }

        .card-layer-depth {
            transform: translateZ(40px);
        }

        /* --- How It Works Animation --- */
        .step-line {
            position: absolute;
            top: 2rem;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #334155 0%, #3b82f6 50%, #334155 100%);
            z-index: 0;
            background-size: 200% 100%;
            animation: gradientMove 3s linear infinite;
        }
        
        @keyframes gradientMove {
            0% { background-position: 100% 0; }
            100% { background-position: -100% 0; }
        }

        .step-card:hover .step-icon {
            transform: scale(1.1);
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
        }

        /* --- Utilities --- */
        .hover-lift {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px -5px rgba(0,0,0,0.1);
        }

        /* Code Block Styling */
        pre {
            background: #1e293b;
            color: #e2e8f0;
            padding: 1rem;
            border-radius: 0.5rem;
            overflow-x: auto;
            font-family: 'Courier New', Courier, monospace;
        }

        /* FAQ Animation */
        details > summary { list-style: none; }
        details > summary::-webkit-details-marker { display: none; }
        details[open] summary ~ * { animation: sweep .3s ease-in-out; }
        @keyframes sweep { 0% {opacity: 0; margin-top: -10px} 100% {opacity: 1; margin-top: 0px} }
    </style>
</head>
