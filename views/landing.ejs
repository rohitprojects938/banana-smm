<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= (data && data.brand_name ? data.brand_name : "Banana SMM") %> - India’s Fastest SMM Panel 2026</title>

    <meta name="description" content="<%= (data && data.hero_headline ? data.hero_headline : "Skyrocket Your Social Presence with Banana SMM Instantly") %> - The #1 Trusted SMM Platform in India.">
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
